    <style name="CustomDatePickerStyle" parent="@android:style/Widget.Material.DatePicker">
        <item name="android:headerBackground">@color/colorPrimary</item>
    </style>

    <style name="DatePickerDialogButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/colorPrimary</item>
    </style>


