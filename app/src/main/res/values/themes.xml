    <style name="CustomDatePicker" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <!-- DatePicker background -->
        <item name="android:datePickerStyle">@style/CustomDatePickerStyle</item>
        <item name="colorAccent">@color/colorSecondary</item>

        <!-- Fix OK/Cancel button colors -->
<!--        <item name="android:textColorPrimary">@android:color/black</item>-->
        <item name="android:buttonBarPositiveButtonStyle">@style/DatePickerDialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/DatePickerDialogButton</item>
